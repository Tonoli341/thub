# Configurazione TLS per la produzione.
#
# Prerequisiti (da fare una volta, fuori da questo repo):
#   1. Ottenere un certificato per il nome pubblico (es. thub.tonoli.com):
#      - CA interna aziendale, oppure
#      - certbot/Let's Encrypt se il nome è risolvibile pubblicamente.
#   2. Copiare certificato e chiave in ./nginx/certs/ (NON committarli).
#   3. In docker-compose.prod.yml montare questo file al posto di prod.conf,
#      aggiungere il volume dei certificati e pubblicare la porta 443:
#        ports:
#          - "8088:80"
#          - "8443:443"
#        volumes:
#          - ./nginx/prod-tls.conf:/etc/nginx/conf.d/default.conf:ro
#          - ./nginx/certs:/etc/nginx/certs:ro
#   4. Aggiornare PUBLIC_API_BASE_URL nel .env (link email) in https://...

server {
    listen 80;
    server_name _;
    # tutto il traffico HTTP viene rediretto su HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name thub.tonoli.com;

    ssl_certificate     /etc/nginx/certs/thub.crt;
    ssl_certificate_key /etc/nginx/certs/thub.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    add_header Strict-Transport-Security "max-age=31536000" always;

    location /api/ {
        proxy_pass http://backend:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        proxy_pass http://backend:8000/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://frontend:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }
}
