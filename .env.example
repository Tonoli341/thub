APP_NAME=Workforce Planner API
APP_ENV=development
API_V1_PREFIX=/api
DATABASE_URL=postgresql+psycopg://planner:planner@db:5432/workforce_planner
CORS_ORIGINS=http://localhost:5173,http://localhost,http://127.0.0.1

POSTGRES_DB=workforce_planner
POSTGRES_USER=planner
POSTGRES_PASSWORD=planner

TMS_HOST=
TMS_PORT=1433
TMS_DATABASE=
TMS_USERNAME=
TMS_PASSWORD=
TMS_EMPLOYEE_PROPERTY_CODE=02
TMS_EMPLOYEE_QUERY=SELECT D.CODICE, D.COGNOME_NOME, D.DOMICILIO_TELEFONO, P.PROPRIETA_CODICE, COALESCE(M.DESCRIZIONE, 'ALTRO') AS DESCRIZIONE, P.VALORE, D.DATORE_LAVORO, D.FOTO FROM T2BaseDipendenti D LEFT JOIN T2BaseDipendentiProprieta P ON P.CODICE = D.CODICE LEFT JOIN T2BaseProprietaDipendenti M ON M.CODICE = P.PROPRIETA_CODICE WHERE D.LICENZIATO = 'N'

LDAP_ENABLED=true
LDAP_URI=ldap://
LDAP_USER_DN=
LDAP_DOMAIN=
LDAP_ALLOWED_GROUP=
LDAP_DEFAULT_ROLE=PLANNER
AWS_SYNC_BASE_URL=

SMTP_ENABLED=true
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
