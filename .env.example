APP_NAME=Workforce Planner API
APP_ENV=development
API_V1_PREFIX=/api
DATABASE_URL=postgresql+psycopg://planner:planner@db:5432/workforce_planner
CORS_ORIGINS=http://localhost:5173,http://localhost,http://127.0.0.1

POSTGRES_DB=workforce_planner
POSTGRES_USER=planner
POSTGRES_PASSWORD=planner

# Obbligatori fuori dallo sviluppo: con i valori di default il backend rifiuta di partire (APP_ENV != development)
JWT_SECRET_KEY=change-this-in-production
# Il frontend rinnova il token in background (/auth/refresh): la scadenza può essere ridotta (es. 60)
JWT_EXPIRE_MINUTES=480

# Servizio Gesap interno (proxato dal backend con autenticazione su /api/gesap/*)
GESAP_BASE_URL=http://192.168.24.21/gesap_dev/sito/api

# Credenziali del "Portale Rendicontazioni" (utente admin da env). Cambiare la password in produzione.
APP_USERNAME=admin
APP_PASSWORD=admin

TMS_HOST=
TMS_PORT=1433
TMS_DATABASE=
TMS_USERNAME=
TMS_PASSWORD=
TMS_EMPLOYEE_PROPERTY_CODE=02
TMS_EXCLUDED_EMPLOYEE_IDS=178,179,180,181,182

STOCKTONOLI_HOST=192.168.23.42
STOCKTONOLI_PORT=1433
STOCKTONOLI_DATABASE=stocktonoli
STOCKTONOLI_USERNAME=
STOCKTONOLI_PASSWORD=

# Query della sorgente value-list "liste_aperte" (Libreria Campi > Value list MSSQL).
# Usa la connessione STOCKTONOLI_*. Il %s è bindato con il codice società
# dell'incrocio (mai interpolato). Override solo se lo schema DB cambia; il
# default è in app/config.py.
# LISTE_APERTE_QUERY=

LDAP_ENABLED=true
LDAP_URI=ldap://
LDAP_USER_DN=
LDAP_DOMAIN=
LDAP_ALLOWED_GROUP=
LDAP_DEFAULT_ROLE=PLANNER
# Read-only service account used to silently refresh LDAP employee data (email, nome, DN)
# from AD in the background while a user's session is active. Leave empty to disable
# background refresh (data will only update again at the user's next password login).
LDAP_SERVICE_BIND_DN=
LDAP_SERVICE_BIND_PASSWORD=
LDAP_AD_SYNC_INTERVAL_HOURS=24

SMTP_ENABLED=true
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# URL pubblico dell'API, usato per i link di approvazione nelle email
PUBLIC_API_BASE_URL=http://localhost:8088/api
# URL pubblico del frontend, usato per i link nelle email (es. firma consegne);
# se vuoto viene ricavato da PUBLIC_API_BASE_URL togliendo il suffisso /api
PUBLIC_WEB_BASE_URL=
# Validità dei link di approvazione via email (minuti)
EMAIL_APPROVAL_TOKEN_EXPIRE_MINUTES=4320

# Chiave condivisa per l'app mobile Consegne (header X-Tablet-Key). Vuota = endpoint tablet disattivati (503).
DELIVERIES_TABLET_API_KEY=23de32fs43h
DELIVERIES_TABLET_LABEL=tablet-consegne

# Integrazione NinjaOne RMM per la sincronizzazione del catalogo dispositivi (PC/smartphone)
# e per l'apertura ticket (services/ninjaone_tickets.py). Client credentials OAuth2
# dell'app API creata su NinjaOne: se si abilita il ticketing, aggiungere lo scope
# "ticketing" (oltre a "monitoring") sul portale NinjaOne e qui sotto.
NINJAONE_BASE_URL=https://eu.ninjarmm.com
NINJAONE_CLIENT_ID=
NINJAONE_CLIENT_SECRET=
NINJAONE_SCOPE=monitoring
# Id dell'organizzazione (client) NinjaOne su cui T-Hub apre i ticket. Vuoto = apertura
# ticket disattivata (errore di dominio esplicito, nessun blocco alla sync dispositivi).
NINJAONE_ORGANIZATION_ID=

# Chiave con cui vengono cifrati a database i segreti delle integrazioni
# (client secret Microsoft 365 e futuri). Generarne una per ambiente:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Cambiarla rende illeggibili i segreti già salvati: vanno reinseriti dalla GUI.
SECRETS_ENCRYPTION_KEY=

# Microsoft 365 (risposta automatica Fuori sede su Outlook): non si configura da
# qui. Interruttore generale, credenziali Entra e opzioni stanno cifrati a
# database e si amministrano da Configurazione › Integrazioni, spenti di default.
